{
  "name": "id-toolbox",
  "version": "1.6.0",
  "description": "ID库工具箱",
  "main": "main.js",
  "author": "Josef Kuba",
  "scripts": {
    "start": "nodemon --watch src --exec electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "evd": "evd"
  },
  "build": {
    "appId": "com.id-toolbox.myapp",
    "productName": "ID工具箱",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "mac": {
      "icon": "src/assets/icons/mac/icon.icns",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "icon": "src/assets/icons/win/icon.ico",
      "target": [
        "nsis"
      ]
    }
  },
  "devDependencies": {
    "@inquirer/prompts": "^1.2.3",
    "changelog-parser": "^3.0.1",
    "commander": "^10.0.1",
    "dompurify": "^3.4.17",
    "download": "^8.0.0",
    "electron": "^36.9.5",
    "electron-builder": "^24.13.3",
    "esno": "^0.16.3",
    "nodemon": "^3.1.4",
    "jsdom": "^22.1.0",
    "log-symbols": "=4.1.0",
    "marked": "^5.0.4",
    "netlify-cli": "^17.34.1",
    "vite": "^4.5.14",
    "wrangler": "^3.114.17"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bootstrap": "^5.3.3",
    "electron-version-deployer-cli": "^0.1.6",
    "fs-extra": "^11.2.0",
    "unzipper": "^0.12.5"
  },
  "nodemonConfig": {
    "watch": [
      "*.js",
      "*.html"
    ],
    "ext": "js,html"
  },
  "overrides": {
    "follow-redirects": "1.16.1"
  }
}
